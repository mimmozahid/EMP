# Flask Configuration
SECRET_KEY=super-secret-key-change-this-in-production
FLASK_ENV=development

# TiDB Database Connection (MySQL Compatible)
# Example TiDB Cloud Connection:
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=test
# TIDB_SSL_CA=/path/to/ca.pem  # Optional custom CA path

# Direct Database URL (Alternative to individual TIDB_* vars)
# DATABASE_URL=mysql+pymysql://3eTGhhSzVVr7RJa.root:bYe6vSRnbmuV0aRc@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test
